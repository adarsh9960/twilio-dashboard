# ITZ Twilio Control Center - server .env (PRODUCTION)
# Server-side secrets. Never commit. chmod 600.
#
# NOTE: values replaced by the deploy script before use.
# The deploy script (deploy-twilio-dashboard.sh) generates SESSION_SECRET
# and DB_PASSWORD at deploy time and writes the real .env file.
#
# Verified admin user (seeded during database setup):
#   ADMIN_EMAIL=admin@itzadarsh.co.in
#   ADMIN_INITIAL_PASSWORD=rjpivifkre4lngh5ai22xr6n6l5jdizl

# ─── App ─────────────────────────────────────────────────────────────────────
APP_URL=https://dashboard.instatool.in
NODE_ENV=production
SESSION_SECRET=CHANGE_ME_GENERATE_AT_DEPLOY
ADMIN_EMAIL=admin@itzadarsh.co.in
ADMIN_INITIAL_PASSWORD=CHANGE_ME_ON_FIRST_LOGIN

# ─── Database (PostgreSQL appdb) ────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=CHANGE_ME_GENERATE_AT_DEPLOY

# ─── Twilio (configured after Twilio approval) ─────────────────────────────
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_API_KEY=CHANGE_ME
TWILIO_API_SECRET=CHANGE_ME
TWILIO_TWIML_APP_SID=CHANGE_ME
TWILIO_PHONE_NUMBER=CHANGE_ME

# ─── Cloudflare Turnstile (optional) ────────────────────────────────────────
CLOUDFLARE_TURNSTILE_SITE_KEY=CHANGE_ME
CLOUDFLARE_TURNSTILE_SECRET_KEY=CHANGE_ME

# ─── Storage ────────────────────────────────────────────────────────────────
UPLOAD_DIR=/home/ubuntu/itz-twilio-dashboard/uploads
RECORDINGS_BASE_URL=/recordings
